<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tic_Tac_Toe_App.AboutPage"
             Title="About">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Image
            Source="dotnet_bot.png"
            HeightRequest="150"
            Aspect="AspectFit"
            SemanticProperties.Description="App icon" />

        <Label
            Text="Tic-Tac-Toe"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Made with .NET MAUI"
            FontSize="16"
            HorizontalOptions="Center" />

        <Label
            Text="Ported from a Java console game (TicTacToeConsole.java)&#10;by Frank McCown, Harding University."
            FontSize="14"
            TextColor="Gray"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center" />

        <Label
            Text="Version 1.0"
            FontSize="14"
            TextColor="Gray"
            HorizontalOptions="Center" />

        <Button
            Text="Close"
            HorizontalOptions="Center"
            Clicked="OnCloseClicked" />

    </VerticalStackLayout>

</ContentPage>
