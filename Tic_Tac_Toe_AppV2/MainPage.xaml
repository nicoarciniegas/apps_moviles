<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tic_Tac_Toe_App.MainPage"
             Title="Tic-Tac-Toe">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New Game" Order="Primary" Clicked="OnResetClicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="&#x21bb;" Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Difficulty" Order="Secondary" Clicked="OnDifficultyClicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2699;" Color="Black" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="About" Order="Secondary" Clicked="OnAboutClicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2139;" Color="Black" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Quit" Order="Secondary" Clicked="OnQuitClicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="OpenSansRegular" Glyph="&#x2716;" Color="Black" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout
        Padding="20"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Tic-Tac-Toe"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Grid
            x:Name="BoardGrid"
            RowSpacing="6"
            ColumnSpacing="6"
            HorizontalOptions="Center"
            WidthRequest="300"
            HeightRequest="300">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" x:Name="Btn0" FontSize="40" Clicked="OnCellClicked" />
            <Button Grid.Row="0" Grid.Column="1" x:Name="Btn1" FontSize="40" Clicked="OnCellClicked" />
            <Button Grid.Row="0" Grid.Column="2" x:Name="Btn2" FontSize="40" Clicked="OnCellClicked" />

            <Button Grid.Row="1" Grid.Column="0" x:Name="Btn3" FontSize="40" Clicked="OnCellClicked" />
            <Button Grid.Row="1" Grid.Column="1" x:Name="Btn4" FontSize="40" Clicked="OnCellClicked" />
            <Button Grid.Row="1" Grid.Column="2" x:Name="Btn5" FontSize="40" Clicked="OnCellClicked" />

            <Button Grid.Row="2" Grid.Column="0" x:Name="Btn6" FontSize="40" Clicked="OnCellClicked" />
            <Button Grid.Row="2" Grid.Column="1" x:Name="Btn7" FontSize="40" Clicked="OnCellClicked" />
            <Button Grid.Row="2" Grid.Column="2" x:Name="Btn8" FontSize="40" Clicked="OnCellClicked" />
        </Grid>

        <Label
            x:Name="StatusLabel"
            Text="Your turn (X)"
            FontSize="20"
            HorizontalOptions="Center" />

        <Label
            x:Name="DifficultyLabel"
            Text="Difficulty: Expert"
            FontSize="14"
            TextColor="Gray"
            HorizontalOptions="Center" />

        <Button
            x:Name="PlayAgainBtn"
            Text="Play Again"
            HorizontalOptions="Center"
            IsVisible="False"
            Clicked="OnResetClicked" />

    </VerticalStackLayout>

</ContentPage>
